# ==============================================================================
# SentryPlate ANPR System - Environment Configuration Template
# ==============================================================================
# Copy this file to '.env' (in project root or backend/) and modify values.
# Do NOT commit your actual '.env' file containing real secrets to Git.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Database Configuration (PostgreSQL)
# ------------------------------------------------------------------------------
DB_HOST=localhost
DB_PORT=5432
DB_NAME=anpr_db
DB_USER=postgres
DB_PASSWORD=1999

# ------------------------------------------------------------------------------
# 2. Authentication & JWT Security
# ------------------------------------------------------------------------------
# Secret key used for signing JWT tokens (generate a strong random string in production)
SECRET_KEY=ANPR_SUPER_SECRET_PRODUCTION_KEY_2026
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# ------------------------------------------------------------------------------
# 3. Plate Scanning & Cooldown Settings
# ------------------------------------------------------------------------------
# Cooldown interval (in seconds) before re-logging the exact same plate
ANPR_COOLDOWN_SECONDS=120

# ------------------------------------------------------------------------------
# 4. YOLO License Plate Detector Configuration
# ------------------------------------------------------------------------------
# Engine options: 'PYTORCH' | 'OPENVINO'
ANPR_YOLO_ENGINE=PYTORCH

# Device options: 'cuda:0' | 'cuda' | 'CPU' | 'GPU.1'
ANPR_YOLO_DEVICE=cuda:0

# Detection confidence threshold (0.0 to 1.0)
ANPR_YOLO_CONF=0.25

# Input image size for YOLO model
ANPR_YOLO_IMGSZ=640

# ------------------------------------------------------------------------------
# 5. OCR Character Recognition Configuration
# ------------------------------------------------------------------------------
# Engine options: 'ONNX' | 'PADDLE'
ANPR_OCR_ENGINE=ONNX

# Device options: 'CPU' | 'GPU'
ANPR_OCR_DEVICE=CPU

# Number of CPU threads for OCR inference
ANPR_CPU_THREADS=4

# Maximum number of retry attempts for low-confidence reads
ANPR_MAX_RETRIES=1
